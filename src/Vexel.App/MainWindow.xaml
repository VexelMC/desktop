<Window x:Class="Vexel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vexel"
        Width="1080"
        Height="720"
        MinWidth="840"
        MinHeight="620"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B111B" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="24">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Vexel" />
                    <TextBlock Margin="0,4,0,40" Foreground="{StaticResource TextSecondary}" Text="Minecraft Bedrock Utility" />

                    <Border Background="#162536" BorderBrush="#275169" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource Accent}" Text="SAFETY MODE" />
                            <TextBlock Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap" Text="Only verified build definitions can be applied." />
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="{StaticResource Accent}" FontWeight="SemiBold" Text="Home" />
                    <TextBlock Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" Text="Fixes" />
                    <TextBlock Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" Text="Compatibility" />
                    <TextBlock Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" Text="Settings" />
                    <TextBlock Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" Text="About" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource TextSecondary}" FontSize="12" Text="Vexel preview · no patches applied" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,40,48,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Content="Refresh status" />
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Text="MINECRAFT" />
                        <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="SemiBold" Text="Minecraft Bedrock" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding GameStatus}" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text="{Binding StatusDetail}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1E3544" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                            <TextBlock FontSize="12" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Text="SAFE" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Client enhancements" />
                    <TextBlock Margin="0,6,0,20" Foreground="{StaticResource TextSecondary}" Text="Features become available only after an exact Minecraft build is verified." />

                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}" Text="{Binding Description}" />
                                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#7E9AAF" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#25323E" CornerRadius="12" Padding="10,5" Margin="24,0,0,0" VerticalAlignment="Top">
                                            <TextBlock FontSize="12" Foreground="#BDD0DE" FontWeight="SemiBold" Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
